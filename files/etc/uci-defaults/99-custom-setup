#!/bin/sh

# Web UI concurrency (safe to repeat on every upgrade)
uci -q delete uhttpd.main.lua_prefix
uci set uhttpd.main.max_requests='10'
uci commit uhttpd

# Everything below is first-install setup only. On an upgrade the saved
# configuration already has a WAN and must not be overwritten.
uci -q get network.wan.device >/dev/null && exit 0

# 1. LAN: Default to standard 192.168.1.1/24, gateway and DHCP server
uci set network.lan.proto='static'
uci set network.lan.ipaddr='192.168.1.1'
uci set network.lan.netmask='255.255.255.0'
uci -q delete network.lan.gateway
uci -q delete network.lan.dns
uci set dhcp.lan.ignore='0'
uci set dhcp.lan.ra='server'
uci set dhcp.lan.dhcpv6='server'

# 2. WAN on the PON, JioFiber IPoE on VLAN 1015
uci set network.wan=interface
uci set network.wan.device='pon0.1015'
uci set network.wan.proto='dhcp'
uci set network.wan.hostname='*'
uci set network.wan.metric='10'

uci set network.wan6=interface
uci set network.wan6.device='pon0.1015'
uci set network.wan6.proto='dhcpv6'
uci set network.wan6.reqaddress='try'
uci set network.wan6.reqprefix='auto'

# 3. Enable xPON / OMCI agent
uci -q set xpon.main.enabled='1'
uci -q set xpon.main.netdev='pon0'
uci -q set xpon.main.vendor_id='SCOM'
uci -q set xpon.main.equipment_id='ECONET'
uci -q set xpon.main.hardware_version='RP0201'
uci -q set xpon.main.software_version_0='JCOW414_R2.59'
uci -q set xpon.main.software_version_1='JCOW414_R2.59'
uci -q set xpon.main.traffic_management_option='2'
uci -q commit xpon

# 4. Wi-Fi Configuration
[ -f /etc/config/wireless ] || wifi config

# 2.4GHz Radio (radio0)
uci -q set wireless.radio0.channel='6'
uci -q set wireless.radio0.htmode='HT20'
uci -q set wireless.radio0.country='IN'
uci -q set wireless.radio0.disabled='0'
uci -q set wireless.default_radio0.disabled='0'
uci -q set wireless.default_radio0.ssid='OpenWrt-JCOW414-2.4G'
uci -q set wireless.default_radio0.encryption='psk2'
uci -q set wireless.default_radio0.key='openwrt123'
uci -q set wireless.default_radio0.network='lan'

# 5GHz Radio (radio1)
uci -q set wireless.radio1.channel='36'
uci -q set wireless.radio1.htmode='VHT80'
uci -q set wireless.radio1.country='IN'
uci -q set wireless.radio1.disabled='0'
uci -q set wireless.default_radio1.disabled='0'
uci -q set wireless.default_radio1.ssid='OpenWrt-JCOW414-5G'
uci -q set wireless.default_radio1.encryption='psk2'
uci -q set wireless.default_radio1.key='openwrt123'
uci -q set wireless.default_radio1.network='lan'

# 5. Commit all changes
uci commit network
uci commit dhcp
uci commit wireless

exit 0
